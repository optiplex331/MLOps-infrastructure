.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.venv/
dist/
build/

# Local platform and cluster state must never be published.
.env
.env.*
!.env.example
credentials.json
**/credentials.json
*.kubeconfig
kubeconfig*
*.pem
*.key
secrets/
secrets/**
**/secrets/**
rendered-secrets/
.k3s/

# Runtime systems of record and generated evidence stay outside Git.
mlruns/
minio-data/
model-cache/
raw-data/
raw-evaluation/
evidence/

# Raw runtime logs, caches, and host evidence must never enter the public tree.
*.log
*.trace
.cache/
**/.cache/
caches/
**/caches/
logs/
**/logs/
host-evidence/
runtime-evidence/
runtime-logs/
out/
