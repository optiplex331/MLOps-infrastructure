#!/usr/bin/env bash
# CPU-safe CI entrypoint for llm-inference-lab-infra.
set -euo pipefail

repository_root=$(cd "$(dirname "$0")/.." && pwd)

"$repository_root/bin/check-public-surface"
"$repository_root/bin/check-chart"

for test_file in \
  test_host_admission.py \
  test_repository_boundaries.py \
  test_ticket05_runtime.py
do
  PYTHONPATH="$repository_root/src" python3 -m unittest discover \
    -s "$repository_root/tests" -p "$test_file" -v
done
