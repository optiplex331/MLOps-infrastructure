#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: $0 --output /absolute/path/cluster-results.json" >&2
  exit 2
}

[[ $# -eq 2 && "$1" == "--output" ]] || usage
output_path=$2
[[ "$output_path" = /* ]] || { echo "output path must be absolute" >&2; exit 2; }
[[ "$(uname -s)" == "Linux" ]] || { echo "cluster admission requires native Ubuntu" >&2; exit 2; }
grep -Eq '^ID=\"?ubuntu\"?$' /etc/os-release || { echo "cluster admission requires Ubuntu" >&2; exit 2; }

repository_root=$(cd "$(dirname "$0")/.." && pwd)
manifest_root="$repository_root/manifests/host-admission"
limits="$repository_root/config/host-admission-limits.v1.json"
namespace=mlops-host-admission
timeout_seconds=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["schedulingTimeoutSeconds"])' "$limits")
idle_seconds=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["idleSampleSeconds"])' "$limits")

for command in k3s kubectl nvidia-smi python3; do
  command -v "$command" >/dev/null || { echo "missing required command: $command" >&2; exit 2; }
done

cleanup() {
  kubectl -n "$namespace" delete pod gpu-smoke gpu-capacity-holder gpu-capacity-contender non-gpu-guard --ignore-not-found --wait=false >/dev/null 2>&1 || true
}
trap cleanup EXIT

node_count=$(kubectl get nodes --no-headers | wc -l | tr -d ' ')
[[ "$node_count" == "1" ]] || { echo "exactly one k3s node is required" >&2; exit 2; }
node=$(kubectl get nodes -o jsonpath='{.items[0].metadata.name}')
kubectl apply -f "$manifest_root/namespace.yaml" >/dev/null
kubectl label node "$node" mlops.local/gpu=rtx-3080 --overwrite >/dev/null
kubectl taint node "$node" mlops.local/gpu=dedicated:NoSchedule --overwrite >/dev/null

allocatable=$(kubectl get node "$node" -o jsonpath='{.status.allocatable.nvidia\.com/gpu}')
[[ "$allocatable" == "1" ]] || { echo "expected exactly one allocatable nvidia.com/gpu" >&2; exit 2; }

idle_start=$(nvidia-smi --query-gpu=temperature.gpu,power.draw --format=csv,noheader,nounits)
sleep "$idle_seconds"
idle_end=$(nvidia-smi --query-gpu=temperature.gpu,power.draw --format=csv,noheader,nounits)

kubectl apply -f "$manifest_root/gpu-smoke.pod.yaml" >/dev/null
kubectl wait -n "$namespace" --for=jsonpath='{.status.phase}'=Succeeded pod/gpu-smoke --timeout=120s >/dev/null
pod_gpu=$(kubectl logs -n "$namespace" gpu-smoke | cut -d, -f1 | xargs)
pod_exit=$(kubectl get pod -n "$namespace" gpu-smoke -o jsonpath='{.status.containerStatuses[0].state.terminated.exitCode}')
container_gpu="$pod_gpu"
[[ "$container_gpu" == "NVIDIA GeForce RTX 3080" ]] || { echo "Kubernetes container did not identify the expected RTX 3080" >&2; exit 2; }
smoke_sample=$(nvidia-smi --query-gpu=temperature.gpu,power.draw,memory.used --format=csv,noheader,nounits)

kubectl apply -f "$manifest_root/non-gpu-guard.pod.yaml" >/dev/null
if kubectl wait -n "$namespace" --for=jsonpath='{.status.phase}'=Running pod/non-gpu-guard --timeout="${timeout_seconds}s" >/dev/null 2>&1; then
  echo "non-GPU workload bypassed the dedicated GPU taint" >&2
  exit 2
fi
non_gpu_reasons=$(kubectl get events -n "$namespace" --field-selector involvedObject.name=non-gpu-guard -o jsonpath='{range .items[*]}{.reason}{"\n"}{end}')
non_gpu_messages=$(kubectl get events -n "$namespace" --field-selector involvedObject.name=non-gpu-guard -o jsonpath='{range .items[*]}{.message}{"\n"}{end}')
grep -q 'FailedScheduling' <<<"$non_gpu_reasons" && grep -qi 'taint' <<<"$non_gpu_messages" || { echo "missing actionable untolerated-taint event" >&2; exit 2; }
kubectl delete pod -n "$namespace" non-gpu-guard --wait=true >/dev/null

kubectl apply -f "$manifest_root/gpu-capacity-holder.pod.yaml" >/dev/null
kubectl wait -n "$namespace" --for=condition=Ready pod/gpu-capacity-holder --timeout=120s >/dev/null
kubectl apply -f "$manifest_root/gpu-capacity-contender.pod.yaml" >/dev/null
if kubectl wait -n "$namespace" --for=jsonpath='{.status.phase}'=Running pod/gpu-capacity-contender --timeout="${timeout_seconds}s" >/dev/null 2>&1; then
  echo "GPU contender ran despite unavailable capacity" >&2
  exit 2
fi
capacity_reasons=$(kubectl get events -n "$namespace" --field-selector involvedObject.name=gpu-capacity-contender -o jsonpath='{range .items[*]}{.reason}{"\n"}{end}')
capacity_messages=$(kubectl get events -n "$namespace" --field-selector involvedObject.name=gpu-capacity-contender -o jsonpath='{range .items[*]}{.message}{"\n"}{end}')
grep -q 'FailedScheduling' <<<"$capacity_reasons" && grep -q 'Insufficient nvidia.com/gpu' <<<"$capacity_messages" || { echo "missing actionable unavailable-GPU event" >&2; exit 2; }

python3 - "$output_path" "$container_gpu" "$pod_gpu" "$pod_exit" "$idle_seconds" "$idle_start" "$idle_end" "$smoke_sample" <<'PY'
import json
from pathlib import Path
import sys

def values(sample):
    return [float(value.strip()) for value in sample.split(",")]

idle_one = values(sys.argv[6])
idle_two = values(sys.argv[7])
smoke = values(sys.argv[8])
result = {
    "cluster": {
        "allocatableGpu": 1,
        "containerGpuModel": sys.argv[2],
        "gpuLimit": 1,
        "gpuRequest": 1,
        "nodeLabel": True,
        "nodeTaint": True,
        "nonGpuOutcome": "untolerated_taint",
        "podExitCode": int(sys.argv[4]),
        "podGpuModel": sys.argv[3],
        "schedulingEventReasons": ["FailedScheduling:UntoleratedTaint", "FailedScheduling:InsufficientGpu"],
        "unavailableGpuOutcome": "insufficient_nvidia_com_gpu",
    },
    "measurements": {
        "idleDurationSeconds": int(sys.argv[5]),
        "idlePowerWatts": max(idle_one[1], idle_two[1]),
        "idleTemperatureC": max(idle_one[0], idle_two[0]),
        "smokeGpuMemoryUsedMiB": int(smoke[2]),
        "smokePowerWatts": smoke[1],
        "smokeTemperatureC": smoke[0],
    },
    "runtime": {"devicePluginReady": True},
}
path = Path(sys.argv[1])
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(result, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8")
PY

echo "$output_path"
