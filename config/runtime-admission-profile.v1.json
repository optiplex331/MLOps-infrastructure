{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "v1",
  "profileId": "rtx3080-single-node-k3s-v1",
  "host": {
    "architecture": "amd64",
    "operatingSystem": "Ubuntu",
    "gpuModel": "NVIDIA GeForce RTX 3080",
    "gpuCount": 1,
    "gpuResource": "nvidia.com/gpu"
  },
  "k3s": {
    "version": "v1.32.6+k3s1",
    "containerRuntime": "embedded-containerd",
    "retainedComponents": ["local-path", "metrics-server"],
    "disabledComponents": ["traefik", "servicelb"]
  },
  "devicePlugin": {
    "chartVersion": "0.17.1",
    "runtimeClassName": "nvidia",
    "migStrategy": "none",
    "failOnInitError": true
  },
  "smoke": {
    "namespace": "mlops-runtime-admission",
    "podName": "gpu-smoke",
    "gpuRequest": 1
  }
}
