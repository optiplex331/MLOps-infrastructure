{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "model", "serving", "metrics", "persistence", "resources"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "metrics": {
      "type": "object",
      "required": ["scrape", "path"],
      "properties": {
        "scrape": {"type": "boolean"},
        "path": {"type": "string", "pattern": "^/"}
      }
    },
    "serving": {
      "type": "object",
      "required": ["maxModelLen", "maxNumSeqs", "maxNewTokens", "gpuMemoryUtilization"],
      "properties": {
        "maxModelLen": {"type": "integer", "minimum": 1},
        "maxNumSeqs": {"type": "integer", "minimum": 1},
        "maxNewTokens": {"type": "integer", "minimum": 1},
        "gpuMemoryUtilization": {"type": "number", "minimum": 0.000001, "maximum": 1}
      }
    },
    "persistence": {
      "type": "object",
      "required": ["storageClassName", "accessMode", "size"],
      "properties": {
        "storageClassName": {"const": "local-path"},
        "accessMode": {"const": "ReadWriteOnce"},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*Gi$"}
      }
    },
    "resources": {"type": "object", "required": ["requests", "limits"]}
  }
}
