{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admissionId": {"const": "local-k3s-gpu-runtime-v1"},
    "collectedAt": {"oneOf": [{"format": "date-time", "type": "string"}, {"type": "null"}]},
    "gates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {"items": {"type": "string"}, "type": "array"},
          "gate": {"enum": ["native_ubuntu_host", "container_gpu_identity", "scheduled_pod_gpu_identity", "node_gpu_policy", "bounded_scheduling_guards", "idle_and_smoke_limits"]},
          "status": {"enum": ["pending", "passed", "failed"]}
        },
        "required": ["gate", "status", "evidence"],
        "type": "object"
      },
      "minItems": 6,
      "type": "array"
    },
    "infrastructureRevision": {"oneOf": [{"pattern": "^[0-9a-f]{40}$", "type": "string"}, {"const": "${INFRASTRUCTURE_REVISION}"}]},
    "limitations": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "observations": {"type": "object"},
    "schemaVersion": {"const": "v1"},
    "status": {"enum": ["pending", "passed", "failed"]},
    "synthetic": {"const": false},
    "target": {
      "additionalProperties": false,
      "properties": {
        "architecture": {"const": "amd64"},
        "gpuCount": {"const": 1},
        "gpuModel": {"const": "NVIDIA GeForce RTX 3080"},
        "nodeCount": {"const": 1},
        "operatingSystem": {"const": "Ubuntu"},
        "runtime": {"const": "native"}
      },
      "required": ["operatingSystem", "runtime", "architecture", "nodeCount", "gpuCount", "gpuModel"],
      "type": "object"
    }
  },
  "required": ["schemaVersion", "admissionId", "status", "synthetic", "infrastructureRevision", "collectedAt", "target", "gates", "observations", "limitations"],
  "type": "object"
}
